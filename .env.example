# Copia este archivo a ".env" (mismo directorio que docker-compose.yml) y
# completa los valores reales. NUNCA subas el ".env" real a git.
#
# Para desarrollo local SIN Docker, copia este mismo contenido a
# hotelflow/.env en vez de a la raíz del repo.

# ---- Django ----
# Genera una clave larga y aleatoria, por ejemplo con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,tu-dominio-del-hotel.com

# ---- Base de datos (PostgreSQL, la usa docker-compose) ----
POSTGRES_DB=hotelflow
POSTGRES_USER=hotelflow
POSTGRES_PASSWORD=change-me

# ---- Redis / Channels (chat en tiempo real) ----
# docker-compose ya define REDIS_URL=redis://redis:6379/0 para el
# contenedor "web"; no hace falta repetirlo aquí salvo que quieras otro valor.

# ---- CORS ----
# Orígenes que pueden llamar a la API, separados por coma.
# Si se deja vacío Y DEBUG=True, se permite cualquier origen (solo para dev).
CORS_ALLOWED_ORIGINS=https://tu-dominio-del-hotel.com

# ---- OpenAI (opcional — generación de turnos con IA) ----
# Si se deja vacío, el generador de roster usa su heurística de respaldo.
OPENAI_API_KEY=

# ---- Producción (Caddy / TLS automático) ----
# Dominio real del hotel, ya apuntando por DNS a este servidor.
DOMAIN=tu-dominio-del-hotel.com
